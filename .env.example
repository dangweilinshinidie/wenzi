# 服务配置
HOST=0.0.0.0
PORT=8000

# 临时文件目录
TEMP_DIR=./tmp

# 临时文件最大保留时间（秒）
TEMP_FILE_MAX_AGE=3600

# ASR 配置
ASR_MODEL=paraformer-zh
ASR_VAD_MODEL=fsmn-vad
ASR_PUNC_MODEL=ct-punc
ASR_DEVICE=cpu
ASR_BATCH_SIZE_S=300

# 下载超时（秒）
DOWNLOAD_TIMEOUT=600
# 元信息探测、单任务总超时（秒）
PROBE_TIMEOUT=30
TASK_TIMEOUT=3600
# 限速（字节/秒，0 表示不限速）与下载线程数
YTDLP_RATE_LIMIT=0
YTDLP_MAX_WORKERS=3
# 这些域名直连，不使用 YTDLP_PROXY，多个域名用逗号分隔
YTDLP_PROXY_DIRECT_DOMAINS=
# 下载前要求的最小可用磁盘空间（MB）
MIN_FREE_SPACE_MB=100

# 最大并发任务数
MAX_TASKS=100

# 多平台 Cookie Vault（每个平台独立保存到 data/cookies/<domain>.txt）
YTDLP_COOKIE_DIR=./data/cookies
# 兼容旧版单文件 Cookie 配置；新接口优先使用 Vault
YTDLP_COOKIE_FILE=
# 可选：chrome、edge 或 firefox；Windows 浏览器数据库被占用/DPAPI 失败时使用手动粘贴
YTDLP_COOKIES_FROM_BROWSER=
# yt-dlp 代理
YTDLP_PROXY=
# 可选：覆盖默认 Chrome UA
YTDLP_USER_AGENT=
